# Database (Supabase pooler URL, e.g. postgresql://[user]:[password]@[host]:[port]/[db]?sslmode=require)
DATABASE_URL=

# CORS
FRONTEND_URL=http://localhost:5173

# Authentication Secrets (generate with `openssl rand -hex 32`)
SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Storage (Optional, for profile photos)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Seed admin
SEED_ADMIN_PASSWORD=Admin123!

# Testing (set ALLOW_DESTRUCTIVE_TESTS=true only in CI with a dedicated test DB)
# TEST_DATABASE_URL=
# ALLOW_DESTRUCTIVE_TESTS=true
